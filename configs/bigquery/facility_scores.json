[
  {
    "name": "ccn",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "CMS Certification Number, 6 characters"
  },
  {
    "name": "t",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "the score month as YYYY-MM"
  },
  {
    "name": "score_month",
    "type": "DATE",
    "mode": "REQUIRED",
    "description": "first day of the score month (the partition)"
  },
  {
    "name": "state",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "two-letter state"
  },
  {
    "name": "chain_id",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "CMS chain id; null for an independent facility"
  },
  {
    "name": "p",
    "type": "FLOAT",
    "mode": "REQUIRED",
    "description": "calibrated probability of the target (p_<target> in the parquet)"
  },
  {
    "name": "target",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "the champion's label, e.g. g12 (a G to L citation within 12 months)"
  },
  {
    "name": "logit",
    "type": "FLOAT",
    "mode": "REQUIRED",
    "description": "log-odds of p"
  },
  {
    "name": "risk_percentile",
    "type": "FLOAT",
    "mode": "REQUIRED",
    "description": "percentile of p among the month's facilities"
  },
  {
    "name": "risk_decile",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "1 = the riskiest tenth"
  },
  {
    "name": "model_name",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "registered model name"
  },
  {
    "name": "model_version",
    "type": "INTEGER",
    "mode": "REQUIRED",
    "description": "registered model version"
  },
  {
    "name": "candidate",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "the champion's candidate (lgbm, lr, ensemble)"
  },
  {
    "name": "gold_run_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "the gold build scored"
  },
  {
    "name": "dataset_version",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "the training dataset version"
  },
  {
    "name": "gold_verified",
    "type": "BOOLEAN",
    "mode": "REQUIRED",
    "description": "false when scored from unverified gold"
  },
  {
    "name": "stale_refresh",
    "type": "BOOLEAN",
    "mode": "REQUIRED",
    "description": "true when the month repeats older data"
  },
  {
    "name": "ml_run_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "the cms_nh_ml run that scored it"
  },
  {
    "name": "scored_at",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "when the month was scored (UTC)"
  }
]
