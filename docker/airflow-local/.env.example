# Copy to .env (git-ignored, chmod 600) and fill in. This file is the ONLY difference between a laptop and the
# GCP VM. On the VM, render it from Secret Manager at deploy time instead of keeping secrets on disk by hand.

# --- images (build them first: docs/runbooks/airflow-local.md). On the VM, pin a git-SHA tag, not :latest ---
PI_AIRFLOW_IMAGE=precursor-airflow:latest
PI_PIPELINE_IMAGE=precursor-pipeline:latest

# --- secrets: required (the stack refuses to start without them); generate them; never commit .env ---
#   openssl rand -hex 32                                   (passwords, JWT secret)
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   (Fernet key)
AIRFLOW_DB_PASSWORD=
PI_META_DB_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=

# --- where pipeline data goes ---
# Laptop: a host folder plays the bucket. Tasks run with `--env dev`, and the folder is bind-mounted at /app/data.
#   On Linux the folder must be writable by the pipeline image's uid 10001 (sudo chown 10001 <dir>).
PI_PIPELINE_ENV=dev
PI_HOST_DATA_DIR=/absolute/path/to/pi-airflow-local/data
# GCP VM: tasks run with `--env prod` against GCS (credentials from the VM's service account, sa-pipeline).
# PI_PIPELINE_ENV=prod
# PI_HOST_DATA_DIR=
# PI_BUCKET_URI=gs://precursor-intel-mlops-data

# --- DAG schedule ---
# Laptop: empty = manual runs only (with a schedule, unpausing starts a run over every in-scope zip).
# VM: a time inside the VM's daily up-window, e.g. 0 15 * * * (an instance schedule may stop it at 00:00 UTC).
PI_DAG_SCHEDULE=
# PI_DAG_SCHEDULE=0 15 * * *

# --- task containers ---
# Memory cap per task, so the OOM killer hits the task (exit 137, retried), not Postgres. VM: 6g.
PI_TASK_MEM_LIMIT=
# Keep failed task containers for debugging (success) or always remove them (force: they hold PI_DATABASE_URL).
PI_AUTO_REMOVE=success
# build_gold is failed (and alerts) after this many minutes, so a hung run doesn't hold the lock. Default 120.
PI_GOLD_TIMEOUT_MINUTES=

# --- alerts by email (docs/runbooks/airflow-local.md §3.1). Empty PI_ALERT_EMAIL_TO = no alerts are sent ---
# Gmail: host smtp.gmail.com, port 587, user = your address, password = an app password (secret).
PI_ALERT_EMAIL_TO=
PI_ALERT_EMAIL_FROM=
PI_ALERT_SMTP_HOST=smtp.gmail.com
PI_ALERT_SMTP_PORT=587
PI_ALERT_SMTP_USER=
PI_ALERT_SMTP_PASSWORD=

# --- host ports (bound to 127.0.0.1 only; on the VM reach the UI through an IAP/SSH tunnel) ---
AIRFLOW_HOST_PORT=8080
PI_POSTGRES_HOST_PORT=55433

# uid of the Airflow containers; files they write live in named volumes. Leave 50000.
AIRFLOW_UID=50000
