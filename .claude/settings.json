{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python -m precursorintelligence.agents.eval *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(terraform fmt *)",
      "Bash(terraform -chdir=infra/terraform/envs/* fmt *)",
      "Bash(terraform -chdir=infra/terraform/envs/* validate *)",
      "Bash(terraform -chdir=infra/terraform/envs/* plan *)",
      "mcp__github"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(gcloud *)",
      "Bash(bq *)",
      "Bash(gsutil *)",
      "Bash(uv add *)",
      "Bash(uv remove *)"
    ],
    "deny": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform * apply *)",
      "Bash(terraform * apply)",
      "Bash(terraform * destroy *)",
      "Bash(terraform * destroy)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gcloud auth print-access-token *)",
      "Bash(gcloud auth application-default print-access-token *)",
      "Bash(gcloud * delete *)",
      "Bash(bq rm *)",
      "Bash(gsutil rm *)",
      "Bash(gsutil -m rm *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*service-account*.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "pydantic-ai@claude-plugins-official": true,
    "astronomer-data@astronomer": true,
    "frontend-design@claude-plugins-official": true,
    "impeccable@impeccable": true
  },
  "extraKnownMarketplaces": {
    "astronomer": {
      "source": {
        "source": "github",
        "repo": "astronomer/agents"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compact-reminder.txt"
          }
        ]
      }
    ]
  }
}
