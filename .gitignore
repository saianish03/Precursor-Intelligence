# --- data & outputs (never commit data; local cache mirrors the GCS layout) ---
data/*
!data/README.md
# DVC pointer files are committed; the data they point to is not (docs/runbooks/gold-snapshot.md)
!data/*.dvc
logs/*
!logs/.gitkeep
mlruns/
*.parquet
*.zip

# --- secrets & local env ---
.env
.env.*
!.env.example
*.pem
*-key.json
credentials*.json
service-account*.json

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- notebooks ---
.ipynb_checkpoints/

# --- terraform ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
~$*

# --- Claude Code (local agent settings, never shared) ---
.claude/
CLAUDE.local.md
