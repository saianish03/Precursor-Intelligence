#!/bin/bash
echo "pi-pg-backup" >> /tmp/pd/log/calls
[ ! -f /tmp/pd/state/busy_after_dump ] || echo 0 > /tmp/pd/state/busy_run
[ ! -f /tmp/pd/state/ssh_after_dump ] || touch /tmp/pd/state/ssh_now
if [ "$(cat /tmp/pd/state/backup_rc 2>/dev/null || echo 0)" != 0 ]; then echo "pi-pg-backup: upload of gs://b/airflow/x.dump failed: 403" >&2; exit 1; fi
echo "pi-pg-backup: gs://b/postgres/airflow/x.dump (10 bytes, MD5 abc)"
echo "pi-pg-backup: gs://b/postgres/precursor_meta/x.dump (10 bytes, MD5 def)"
